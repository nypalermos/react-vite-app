# Copy to docker/.env and replace placeholder values before running prod compose.
# Never commit real secrets.

# Container images (from GHCR after Deploy on main)
API_IMAGE=ghcr.io/your-github-username/react-api:latest
WEB_IMAGE=ghcr.io/your-github-username/react-web:latest

# MongoDB root (admin) credentials — used only for container init/healthchecks
MONGO_ROOT_USERNAME=prodroot
MONGO_ROOT_PASSWORD=change-me-root-password

# Application database user (API connects with this account)
MONGO_APP_USERNAME=app_user
MONGO_APP_PASSWORD=change-me-app-password
MONGO_APP_DATABASE=react_vite_app

# Full URI for the API. Use authSource matching the DB where the app user was created.
# Prefer passwords without @ : / ? # so the URI stays simple; otherwise URL-encode them.
MONGODB_URI=mongodb://app_user:change-me-app-password@mongodb:27017/react_vite_app?authSource=react_vite_app

# API write-endpoint auth (JWT). Change these before any real deployment.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
JWT_EXPIRE_MINUTES=480

# Browser origins allowed by the API CORS middleware (comma-separated).
# Local Vite: http://localhost:5173
# Prod compose (same-origin via nginx /api proxy still works without CORS;
# keep this for any direct browser→API access and local HTTPS testing):
CORS_ORIGINS=https://localhost,https://127.0.0.1
